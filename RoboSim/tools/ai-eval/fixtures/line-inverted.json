  "code": {
    "language": "cpp",
    "files": [
      {
        "name": "sketch.ino",
        "content": "// Line follower: the sensor outputs HIGH (1) over the black line.\nconst int LEFT = 2;\nconst int CENTER = 3;\nconst int RIGHT = 4;\n\nvoid drive(int l1, int l2, int r1, int r2) {\n  digitalWrite(5, l1); digitalWrite(6, l2);\n  digitalWrite(7, r1); digitalWrite(8, r2);\n}\n\nvoid setup() {\n  for (int p = 5; p <= 8; p++) pinMode(p, OUTPUT);\n  pinMode(LEFT, INPUT); pinMode(CENTER, INPUT); pinMode(RIGHT, INPUT);\n}\n\nvoid loop() {\n  if (digitalRead(CENTER) == LOW) {\n    drive(HIGH, LOW, HIGH, LOW);   // forward\n  } else if (digitalRead(LEFT) == HIGH) {\n    drive(LOW, LOW, HIGH, LOW);    // turn left\n  } else {\n    drive(HIGH, LOW, LOW, LOW);    // turn right\n  }\n}\n"
      }
    ]
