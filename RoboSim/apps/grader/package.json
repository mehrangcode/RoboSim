{
  "name": "@robosim/grader",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "robosim-grade": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:golden": "vitest run test/golden.test.ts",
    "golden:update": "UPDATE_GOLDEN=1 vitest run test/golden.test.ts",
    "grade": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@robosim/sim-runtime": "workspace:*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@robosim/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
