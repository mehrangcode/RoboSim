      "code": {
        "language": "cpp",
        "files": [
          {
            "name": "sketch.ino",
            "content": "// NeoPixel rainbow: 8 WS2812B LEDs on D6 (through 330 Ω) cycle through the colour wheel; the knob on\n// A0 sets the brightness.\n#include <Adafruit_NeoPixel.h>\n\nconst int LEDS = 8;\nAdafruit_NeoPixel strip(LEDS, 6, NEO_GRB + NEO_KHZ800);\nuint16_t hue = 0;\n\nvoid setup() {\n  strip.begin();\n  strip.show();\n}\n\nvoid loop() {\n  strip.setBrightness(map(analogRead(A0), 0, 1023, 5, 255));\n  for (int i = 0; i < LEDS; i++)\n    strip.setPixelColor(i, strip.gamma32(strip.ColorHSV(hue + i * (65536L / LEDS))));\n  strip.show();\n  hue += 512;\n  delay(20);\n}\n"
          }
        ]
      },
