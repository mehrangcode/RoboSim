      "code": {
        "language": "cpp",
        "files": [
          {
            "name": "sketch.ino",
            "content": "// Keypad door lock with the Keypad library: type 1234 then # to unlock (green LED on D12).\n// * clears what you typed. Rows R1-R4 on D9..D6, columns C1-C4 on D5..D2.\n#include <Keypad.h>\nconst byte ROWS = 4;\nconst byte COLS = 4;\nchar keys[ROWS][COLS] = {\n  {'1', '2', '3', 'A'},\n  {'4', '5', '6', 'B'},\n  {'7', '8', '9', 'C'},\n  {'*', '0', '#', 'D'},\n};\nbyte rowPins[ROWS] = {9, 8, 7, 6};\nbyte colPins[COLS] = {5, 4, 3, 2};\nKeypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);\nString typed = \"\";\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(12, OUTPUT);\n  Serial.println(\"Enter code, then #\");\n}\n\nvoid loop() {\n  char key = keypad.getKey();\n  if (!key) return;\n  Serial.print(key);\n  if (key == '*') {\n    typed = \"\";\n    digitalWrite(12, LOW);\n    Serial.println();\n  } else if (key == '#') {\n    bool ok = typed == \"1234\";\n    digitalWrite(12, ok ? HIGH : LOW);\n    Serial.println(ok ? \" unlocked\" : \" wrong code\");\n    typed = \"\";\n  } else {\n    typed += key;\n  }\n}\n"
          }
        ]
      },
