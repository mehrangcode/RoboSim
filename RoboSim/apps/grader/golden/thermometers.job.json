      "code": {
        "language": "cpp",
        "files": [
          {
            "name": "sketch.ino",
            "content": "// Two thermometers: a DHT11 module on D2 (temperature + humidity) and a DS18B20 on D4 (1-Wire, with a\n// 4.7 kΩ pull-up). Both are read every 2 s and printed to the serial monitor.\n#include <DHT.h>\n#include <OneWire.h>\n#include <DallasTemperature.h>\n\nDHT dht(2, DHT11);\nOneWire oneWire(4);\nDallasTemperature sensors(&oneWire);\n\nvoid setup() {\n  Serial.begin(9600);\n  dht.begin();\n  sensors.begin();\n  Serial.print(sensors.getDeviceCount());\n  Serial.println(\" DS18B20 found\");\n}\n\nvoid loop() {\n  delay(2000);\n  float humidity = dht.readHumidity();\n  float temperature = dht.readTemperature();\n  if (isnan(humidity) || isnan(temperature)) {\n    Serial.println(\"DHT11 read failed\");\n  } else {\n    Serial.print(\"DHT11 \");\n    Serial.print(temperature, 0);\n    Serial.print(\" C \");\n    Serial.print(humidity, 0);\n    Serial.println(\" %\");\n  }\n  sensors.requestTemperatures();\n  Serial.print(\"DS18B20 \");\n  Serial.print(sensors.getTempCByIndex(0), 2);\n  Serial.println(\" C\");\n}\n"
          }
        ]
      },
