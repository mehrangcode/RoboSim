        "files": [
          {
            "name": "sketch.ino",
            "content": "// SSD1306 OLED on I²C (SDA A4, SCL A5, address 0x3C): a title, the knob on A0 as a number and a bar.\n#include <Wire.h>\n#include <Adafruit_GFX.h>\n#include <Adafruit_SSD1306.h>\n\nAdafruit_SSD1306 display(128, 64, &Wire, -1);\n\nvoid setup() {\n  Serial.begin(9600);\n  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {\n    Serial.println(\"SSD1306 not found\");\n    for (;;) {}\n  }\n  display.setTextColor(SSD1306_WHITE);\n}\n\nvoid loop() {\n  int knob = analogRead(A0);\n  display.clearDisplay();\n  display.setTextSize(2);\n  display.setCursor(0, 0);\n  display.println(\"RoboSim\");\n  display.setTextSize(1);\n  display.setCursor(0, 24);\n  display.print(\"Knob: \");\n  display.println(knob);\n  display.drawRect(0, 40, 128, 14, SSD1306_WHITE);\n  display.fillRect(2, 42, map(knob, 0, 1023, 0, 124), 10, SSD1306_WHITE);\n  display.display();\n  delay(100);\n}\n"
          }
        ]
