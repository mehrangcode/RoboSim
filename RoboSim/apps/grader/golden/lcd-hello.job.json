        "files": [
          {
            "name": "sketch.ino",
            "content": "// 16x2 LCD with a PCF8574 I²C backpack (address 0x27): a greeting with a custom heart, then the uptime.\n#include <Wire.h>\n#include <LiquidCrystal_I2C.h>\n\nLiquidCrystal_I2C lcd(0x27, 16, 2);\nbyte heart[8] = {0b00000, 0b01010, 0b11111, 0b11111, 0b01110, 0b00100, 0b00000, 0b00000};\n\nvoid setup() {\n  lcd.init();\n  lcd.backlight();\n  lcd.createChar(0, heart);\n  lcd.setCursor(0, 0);\n  lcd.print(\"Hello, RoboSim \");\n  lcd.write(0);\n}\n\nvoid loop() {\n  lcd.setCursor(0, 1);\n  lcd.print(\"Uptime: \");\n  lcd.print(millis() / 1000);\n  lcd.print(\" s   \");\n  delay(250);\n}\n"
          }
        ]
