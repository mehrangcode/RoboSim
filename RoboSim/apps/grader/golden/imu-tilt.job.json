      "code": {
        "language": "cpp",
        "files": [
          {
            "name": "sketch.ino",
            "content": "// MPU-6050 (I²C 0x68): prints acceleration and rotation, and lights the LED on D13 past 20° of tilt.\n#include <Wire.h>\n#include <Adafruit_MPU6050.h>\n#include <Adafruit_Sensor.h>\n\nAdafruit_MPU6050 mpu;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(13, OUTPUT);\n  if (!mpu.begin()) {\n    Serial.println(\"MPU6050 not found\");\n    for (;;) {}\n  }\n  mpu.setAccelerometerRange(MPU6050_RANGE_2_G);\n  mpu.setGyroRange(MPU6050_RANGE_250_DEG);\n  mpu.setFilterBandwidth(MPU6050_BAND_21_HZ);\n}\n\nvoid loop() {\n  sensors_event_t a, g, temp;\n  mpu.getEvent(&a, &g, &temp);\n  float tilt = degrees(atan2(sqrt(a.acceleration.x * a.acceleration.x + a.acceleration.y * a.acceleration.y),\n                             a.acceleration.z));\n  digitalWrite(13, tilt > 20 ? HIGH : LOW);\n  Serial.print(\"tilt \");\n  Serial.print(tilt, 1);\n  Serial.print(\" deg, turn \");\n  Serial.print(degrees(g.gyro.z), 1);\n  Serial.println(\" deg/s\");\n  delay(500);\n}\n"
          }
        ]
      },
