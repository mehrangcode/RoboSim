      "code": {
        "language": "cpp",
        "files": [
          {
            "name": "sketch.ino",
            "content": "// Half adder in hardware: a 74HC86 XOR makes the sum, a 74HC08 AND the carry, straight from the two\n// buttons. The Uno only reads the result (sum on D2, carry on D3) and prints it when it changes.\nint last = -1;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(2, INPUT);\n  pinMode(3, INPUT);\n}\n\nvoid loop() {\n  int sum = digitalRead(2);\n  int carry = digitalRead(3);\n  int now = carry * 2 + sum;\n  if (now != last) {\n    Serial.print(\"carry=\");\n    Serial.print(carry);\n    Serial.print(\" sum=\");\n    Serial.println(sum);\n    last = now;\n  }\n}\n"
          }
        ]
      },
