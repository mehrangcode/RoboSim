      "code": {
        "language": "cpp",
        "files": [
          {
            "name": "sketch.ino",
            "content": "// Soft start with a logic-level MOSFET: D6 drives an IRLZ44N's gate through 220 Ω, and 10 kΩ holds the\n// gate low while the Uno boots. The motor ramps up over 2 s, runs, ramps down, rests, and repeats.\nconst int GATE_PIN = 6;\n\nvoid setup() {\n  Serial.begin(9600);\n  pinMode(GATE_PIN, OUTPUT);\n}\n\nvoid ramp(int from, int to) {\n  int step = from < to ? 5 : -5;\n  for (int duty = from; duty != to; duty += step) {\n    analogWrite(GATE_PIN, duty);\n    delay(40);\n  }\n  analogWrite(GATE_PIN, to);\n}\n\nvoid loop() {\n  Serial.println(\"ramp up\");\n  ramp(0, 255);\n  Serial.println(\"full speed\");\n  delay(1500);\n  Serial.println(\"ramp down\");\n  ramp(255, 0);\n  Serial.println(\"rest\");\n  delay(1000);\n}\n"
          }
        ]
      },
