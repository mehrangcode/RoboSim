{
  "name": "@robosim/code-analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./web-tree-sitter.wasm": "./dist/wasm/web-tree-sitter.wasm",
    "./tree-sitter-cpp.wasm": "./dist/wasm/tree-sitter-cpp.wasm"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-wasm.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@robosim/config": "workspace:*",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@robosim/sim-core": "workspace:*",
    "tree-sitter-cpp": "0.23.4",
    "web-tree-sitter": "0.27.0"
  }
}
