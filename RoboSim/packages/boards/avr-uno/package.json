{
  "name": "@robosim/board-avr-uno",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pins": {
      "types": "./dist/pins.d.ts",
      "default": "./dist/pins.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:conformance": "vitest run test/conformance",
    "gen:decoder": "node scripts/gen-decoder.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@robosim/sim-core": "workspace:*",
    "avr8js": "0.21.1"
  },
  "devDependencies": {
    "@robosim/config": "workspace:*",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "5.0.4",
    "eslint": "^10.12.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
