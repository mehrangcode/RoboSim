{
  "name": "@robosim/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arenas": {
      "types": "./dist/arenas/index.d.ts",
      "default": "./dist/arenas/index.js"
    },
    "./guided": {
      "types": "./dist/guided/index.d.ts",
      "default": "./dist/guided/index.js"
    },
    "./guided/firmware": {
      "types": "./dist/guided/firmware.d.ts",
      "default": "./dist/guided/firmware.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@robosim/sim-core": "workspace:*",
    "@robosim/shared": "workspace:*",
    "@robosim/component-chassis-2wd": "workspace:*"
  },
  "devDependencies": {
    "@robosim/config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
