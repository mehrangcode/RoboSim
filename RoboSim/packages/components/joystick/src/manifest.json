{
  "id": "sensor.joystick",
  "version": "1.0.0",
  "category": "sensor",
  "tier": "basic",
  "phase": "P1",
  "nameKey": "sensor.joystick.name",
  "pins": [
    { "name": "gnd", "kind": "ground" },
    { "name": "vcc", "kind": "power" },
    { "name": "vrx", "kind": "output" },
    { "name": "vry", "kind": "output" },
    { "name": "sw", "kind": "passive" }
  ],
  "props": {},
  "inputs": [
    { "name": "x", "type": "number", "default": 0, "min": -1, "max": 1 },
    { "name": "y", "type": "number", "default": 0, "min": -1, "max": 1 },
    { "name": "pressed", "type": "boolean", "default": false }
  ],
  "massG": 10,
  "limits": { "maxVoltageV": 5.5 },
  "polarity": ["vcc", "gnd"]
