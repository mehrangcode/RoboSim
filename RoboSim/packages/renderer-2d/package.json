    "@robosim/content": "workspace:*",
    "@vitest/browser-playwright": "5.0.4",
    "eslint": "^10.12.0",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  }
}
