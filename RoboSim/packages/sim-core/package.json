{
  "name": "@robosim/sim-core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dmath": {
      "types": "./dist/dmath/index.d.ts",
      "default": "./dist/dmath/index.js"
    },
    "./mass": {
      "types": "./dist/world/mass.d.ts",
      "default": "./dist/world/mass.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@robosim/config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "planck": "1.5.0"
  }
}
