# Copy to .env — defaults match infra/docker/docker-compose.yml (Engineering Guide §2.3)
NODE_ENV=development
APP_ENV=local
API_PORT=3000
DATABASE_URL=postgres://robosim:robosim@localhost:5432/robosim
# Use an in-process PGlite database instead of PostgreSQL (no Docker needed); file path or "memory://"
DATABASE_DRIVER=postgres
PGLITE_DATA_DIR=./.local/pglite
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=robosim-dev
BAO_ADDR=http://localhost:8200
LOG_LEVEL=info
# OpenTelemetry: tracing is enabled only when an OTLP endpoint is set
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=robosim-api
# Comma-separated overrides, e.g. "collab.realtime=on,blocks=off"
FEATURE_FLAGS_OVERRIDE=
# Build service (ADR-022): `local` = avr-gcc in a Linux namespace sandbox; run `pnpm compiler:setup` once
COMPILER_RUNTIME=local
# COMPILER_TOOLCHAIN_DIR=./.local/toolchain
# COMPILER_CACHE_DIR=./.local/compiler-cache
COMPILER_MAX_CONCURRENCY=2
BUILD_RATE_LIMIT_PER_MIN=20
BUILD_GUEST_RATE_LIMIT_PER_MIN=5
BUILD_DAILY_QUOTA=200
BUILD_USER_CONCURRENCY=2
# ARTIFACT_STORE_DIR=./.local/artifacts
# Until sign-in lands (P2), local/test requests act as this user (created on first use); never on in staging/production.
# DEV_IDENTITY=true
DEV_IDENTITY_EMAIL=learner@dev.local
AI_DEFAULT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
