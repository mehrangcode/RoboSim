{
  "name": "robosim",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "pnpm --filter @robosim/i18n run check",
    "arch:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:generate": "pnpm --filter @robosim/api run db:generate",
    "db:migrate": "pnpm --filter @robosim/api run db:migrate",
    "db:seed": "pnpm --filter @robosim/api run db:seed",
    "verify": "pnpm format:check && pnpm i18n:check && pnpm arch:check && turbo run lint typecheck test build && pnpm bundle:check",
    "bundle:check": "node tools/check-bundle-size.ts"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.6.0",
    "prettier": "^3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
